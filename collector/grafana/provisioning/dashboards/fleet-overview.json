{
  "uid": "rw-fleet-overview",
  "title": "VPN Fleet — Overview",
  "tags": ["remnawave", "logs"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "node",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values(node)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Access lines/sec (fleet)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "refId": "A", "expr": "sum(rate({service=\"xray\", stream=\"access\", node=~\"$node\"}[5m]))" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Active nodes (last 1h)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "refId": "A", "expr": "count(sum by (node) (count_over_time({service=\"xray\", stream=\"access\"}[1h])))" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Error lines/sec (fleet)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } } },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "refId": "A", "expr": "sum(rate({service=\"xray\", stream=\"error\", node=~\"$node\"}[5m]))" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Unique users seen (range)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "refId": "A", "expr": "count(sum by (tid) (count_over_time({service=\"xray\", stream=\"access\", node=~\"$node\"} | regexp \"email: (?P<tid>[0-9]+)\" | tid != \"\" [$__range])))" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Access rate by node",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 15, "stacking": { "mode": "normal" } }, "unit": "cps" } },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] } },
      "targets": [
        { "refId": "A", "expr": "sum by (node) (rate({service=\"xray\", stream=\"access\", node=~\"$node\"}[5m]))", "legendFormat": "{{node}}" }
      ]
    },
    {
      "id": 6,
      "type": "piechart",
      "title": "Outbound distribution (range)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "options": { "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] }, "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "refId": "A", "instant": true, "expr": "sum by (outbound) (count_over_time({service=\"xray\", stream=\"access\", node=~\"$node\"} | regexp \"-> (?P<outbound>[^\\\\]]+)\\\\] email:\" [$__range]))", "legendFormat": "{{outbound}}" }
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Top 25 destinations (range)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 12 },
      "options": { "showHeader": true, "sortBy": [ { "displayName": "Value", "desc": true } ] },
      "targets": [
        { "refId": "A", "instant": true, "format": "table", "expr": "topk(25, sum by (dest) (count_over_time({service=\"xray\", stream=\"access\", node=~\"$node\"} | regexp \"accepted [a-z0-9]+:(?P<dest>.+):[0-9]+ \\\\[\" | dest != \"\" [$__range])))" }
      ],
      "transformations": [ { "id": "labelsToFields", "options": {} }, { "id": "organize", "options": { "excludeByName": { "Time": true } } } ]
    },
    {
      "id": 8,
      "type": "table",
      "title": "Top 25 users by connections (range)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 12 },
      "options": { "showHeader": true, "sortBy": [ { "displayName": "Value", "desc": true } ] },
      "targets": [
        { "refId": "A", "instant": true, "format": "table", "expr": "topk(25, sum by (tid) (count_over_time({service=\"xray\", stream=\"access\", node=~\"$node\"} | regexp \"email: (?P<tid>[0-9]+)\" | tid != \"\" [$__range])))" }
      ],
      "transformations": [ { "id": "labelsToFields", "options": {} }, { "id": "organize", "options": { "excludeByName": { "Time": true }, "renameByName": { "tid": "user t_id" } } } ]
    }
  ]
}
