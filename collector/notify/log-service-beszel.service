[Unit]
Description=Receive private Beszel status and disk events
Wants=network-online.target
After=network-online.target
ConditionPathExists=/opt/logcollector/notify/beszel.json

[Service]
ExecStart=/usr/bin/python3 /opt/logcollector/notify/beszel.py serve
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
InaccessiblePaths=-/opt/logcollector/notify/config.json
ReadWritePaths=/var/lib/log-service-notify/beszel-queue

[Install]
WantedBy=multi-user.target
